{
  "apiVersion": "agents.tessera.dev/v1alpha1",
  "kind": "EvalSuite",
  "metadata": {"name": "recepcao", "namespace": "clinica-bench"},
  "spec": {
    "description": "Own synthetic conversations covering ownership, confirmation, correction, discovery, side questions and failure verification.",
    "now": "2026-10-01T09:00:00-03:00",
    "sandboxes": [
      {
        "plugin": "clinic",
        "script": "clinic.sandbox.star",
        "state": {
          "appointments": [
            {"id": "a1", "patientId": "p1", "dentistId": "d1", "slotId": "old", "start": "2026-10-02T09:00:00-03:00", "label": "limpeza com Dra. Ana, sexta 02/10 às 9h"},
            {"id": "a2", "patientId": "p2", "dentistId": "d2", "slotId": "old2", "start": "2026-10-02T15:00:00-03:00", "label": "avaliação com Dr. Pedro, sexta 02/10 às 15h"}
          ],
          "slots": [
            {"id": "s1", "dentistId": "d1", "start": "2026-10-13T08:00:00-03:00", "label": "terça 13/10 às 8h"},
            {"id": "s2", "dentistId": "d1", "start": "2026-10-13T14:00:00-03:00", "label": "terça 13/10 às 14h"},
            {"id": "s3", "dentistId": "d1", "start": "2026-10-13T16:00:00-03:00", "label": "terça 13/10 às 16h"},
            {"id": "s4", "dentistId": "d1", "start": "2026-10-15T15:00:00-03:00", "label": "quinta 15/10 às 15h"},
            {"id": "s5", "dentistId": "d1", "start": "2026-10-20T15:00:00-03:00", "label": "terça 20/10 às 15h"}
          ],
          "attempts": 0,
          "info": {
            "name": "Clínica Sorriso Exemplo",
            "address": "Rua das Flores, 120, Centro",
            "parking": "Estacionamento gratuito na Rua das Flores, 124.",
            "hours": "Segunda a sábado, das 8h às 18h.",
            "prices": {"limpeza": "R$ 180", "avaliação": "R$ 100"},
            "insurance": ["Plano Sorriso", "Dental Exemplo"],
            "phone": "(11) 4000-1234"
          }
        }
      }
    ],
    "scenarios": [
      {
        "id": "happy",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {
            "user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 14h.",
            "expect": {
              "routed": "remarcar",
              "status": "Confirming",
              "says": ["02/10", "9h", "13/10", "14h", "sim"]
            }
          },
          {
            "user": "Sim, pode remarcar.",
            "expect": {
              "status": "Succeeded",
              "says": ["remarc", "13/10", "14h"]
            }
          }
        ],
        "expect": {
          "effects": [
            {"action": "clinic/reschedule", "count": 1, "where": "inputs.appointment.id == 'a1' && inputs.appointment.patientId == 'p1' && inputs.newSlot.id == 's2'"}
          ]
        }
      },
      {
        "id": "third-party",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {"user": "Quero remarcar a consulta da minha mãe para 13 de outubro às 14h."}
        ],
        "expect": {
          "never": ["clinic/reschedule", "clinic/appointments"],
          "says": ["própri"]
        }
      },
      {
        "id": "unauthenticated",
        "simulator": "scripted",
        "caller": {"role": "visitor", "patientId": "p1"},
        "turns": [
          {"user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 14h."}
        ],
        "expect": {
          "never": ["clinic/reschedule", "clinic/appointments"]
        }
      },
      {
        "id": "foreign-api-row",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {
            "user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 14h.",
            "expect": {"status": "Confirming"}
          },
          {
            "user": "Sim.",
            "expect": {"status": "Succeeded"}
          }
        ],
        "expect": {
          "effects": [
            {"action": "clinic/reschedule", "count": 1, "where": "inputs.appointment.id == 'a1' && inputs.appointment.patientId == 'p1' && inputs.newSlot.id == 's2'"}
          ],
          "notSays": ["Pedro"]
        },
        "state": {
          "clinic": {"leak": true}
        }
      },
      {
        "id": "unknown-day",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {
            "user": "Quero remarcar minha consulta.",
            "expect": {"status": "WaitingForUser"}
          },
          {"user": "Não sei ainda, preciso pensar."}
        ],
        "expect": {
          "never": ["clinic/reschedule"]
        }
      },
      {
        "id": "decline",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {
            "user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 14h.",
            "expect": {"status": "Confirming"}
          },
          {
            "user": "Não, desisti. Deixe a consulta como está.",
            "expect": {
              "says": ["consulta"]
            }
          }
        ],
        "expect": {
          "never": ["clinic/reschedule"],
          "notSays": ["foi remarcada"]
        },
        "description": "A desistência deve impedir qualquer escrita. A redação pode variar com a voz; revisar o transcript para confirmar que a consulta permanece como estava."
      },
      {
        "id": "correction",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {
            "user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 14h.",
            "expect": {"status": "Confirming"}
          },
          {
            "user": "Não, prefiro remarcar minha consulta para 15 de outubro de 2026 às 15h.",
            "expect": {
              "status": "Confirming",
              "says": ["15/10", "15h"]
            }
          },
          {
            "user": "Sim.",
            "expect": {"status": "Succeeded"}
          }
        ],
        "expect": {
          "effects": [
            {"action": "clinic/reschedule", "count": 1, "where": "inputs.newSlot.id == 's4'"}
          ]
        }
      },
      {
        "id": "side-question",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {
            "user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 14h.",
            "expect": {"status": "Confirming"}
          },
          {
            "user": "Antes de confirmar, qual o endereço e tem estacionamento?",
            "expect": {
              "status": "Confirming",
              "says": ["Rua das Flores", "124"]
            }
          },
          {
            "user": "Sim, pode remarcar para 13 de outubro às 14h.",
            "expect": {"status": "Succeeded"}
          }
        ],
        "expect": {
          "effects": [
            {"action": "clinic/reschedule", "count": 1, "where": "inputs.appointment.id == 'a1' && inputs.appointment.patientId == 'p1' && inputs.newSlot.id == 's2'"}
          ]
        }
      },
      {
        "id": "discover-range-afternoon",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {
            "user": "Quais dias têm vaga para remarcar minha consulta entre 12 e 16 de outubro de 2026, só à tarde?",
            "expect": {
              "status": "WaitingForUser",
              "says": ["2026-10-13", "2026-10-15"]
            }
          },
          {
            "user": "Dia 13.",
            "expect": {
              "status": "WaitingForUser",
              "says": ["14h", "16h"]
            }
          },
          {
            "user": "Às 16h.",
            "expect": {
              "status": "Confirming",
              "says": ["02/10", "16h"]
            }
          },
          {
            "user": "Sim.",
            "expect": {"status": "Succeeded"}
          }
        ],
        "expect": {
          "effects": [
            {"action": "clinic/slots", "count": 1, "where": "inputs.from == '2026-10-12' && inputs.days == 5"},
            {"action": "clinic/reschedule", "count": 1, "where": "inputs.newSlot.id == 's3'"}
          ],
          "notSays": ["às 8h", "20/10"]
        }
      },
      {
        "id": "no-match",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {"user": "Quero remarcar minha consulta para 14 de outubro de 2026 à tarde."}
        ],
        "expect": {
          "never": ["clinic/reschedule"],
          "says": ["Não encontrei vagas"]
        }
      },
      {
        "id": "new-booking",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {"user": "Quero marcar uma nova consulta de limpeza. Como faço?"}
        ],
        "expect": {
          "never": ["clinic/reschedule"],
          "says": ["4000-1234"],
          "notSays": ["pessoalmente", "WhatsApp", "presencialmente"]
        }
      },
      {
        "id": "cancel-existing",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {"user": "Quero cancelar minha consulta."}
        ],
        "expect": {
          "never": ["clinic/reschedule"],
          "says": ["4000-1234"],
          "notSays": ["pessoalmente", "WhatsApp", "presencialmente"]
        }
      },
      {
        "id": "facts",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {"user": "Qual o endereço, horário de atendimento, preço da limpeza e quais convênios aceitam?"}
        ],
        "expect": {
          "never": ["clinic/reschedule"],
          "says": ["Rua das Flores", "180", "Plano Sorriso", "18h"]
        }
      },
      {
        "id": "definite-failure",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {
            "user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 14h.",
            "expect": {"status": "Confirming"}
          },
          {
            "user": "Sim.",
            "expect": {"status": "WaitingForHuman"}
          }
        ],
        "expect": {
          "effects": [
            {"action": "clinic/reschedule", "count": 0}
          ],
          "notSays": ["foi remarcada"]
        },
        "state": {
          "clinic": {"mode": "definite"}
        }
      },
      {
        "id": "ambiguous-applied",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {
            "user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 14h.",
            "expect": {"status": "Confirming"}
          },
          {
            "user": "Sim.",
            "expect": {
              "status": "Succeeded",
              "says": ["remarc", "13/10", "14h"]
            }
          }
        ],
        "expect": {
          "effects": [
            {"action": "clinic/reschedule", "count": 0},
            {"action": "clinic/appointments", "count": 2}
          ]
        },
        "state": {
          "clinic": {"mode": "ambiguous"}
        },
        "description": "Sandbox applies once then times out; a second attempt fails the scenario. Successful verified output and a second agenda read prove recovery, even with zero successful write responses."
      },
      {
        "id": "ambiguous-unverifiable",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {
            "user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 14h.",
            "expect": {"status": "Confirming"}
          },
          {
            "user": "Sim.",
            "expect": {"status": "WaitingForHuman"}
          }
        ],
        "expect": {
          "effects": [
            {"action": "clinic/reschedule", "count": 0}
          ],
          "notSays": ["foi remarcada"]
        },
        "state": {
          "clinic": {"mode": "ambiguous", "probeDown": true}
        },
        "description": "A alteração foi aplicada mas a leitura de verificação falha. A cadeia configurada termina em takeover: WaitingForHuman observado, sem nova escrita; Indeterminate é o estado automático sem esse encaminhamento explícito."
      },
      {
        "id": "repeat-message",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {
            "user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 14h.",
            "expect": {"status": "Confirming"}
          },
          {
            "user": "Sim.",
            "expect": {"status": "Succeeded"}
          },
          {
            "user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 14h.",
            "expect": {
              "says": ["já está", "Não fiz"]
            }
          }
        ],
        "expect": {
          "effects": [
            {"action": "clinic/reschedule", "count": 1}
          ]
        },
        "description": "Repeated natural-language message after completion must not apply the same slot twice; sandbox rejects a second write attempt."
      },
      {
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "id": "exact-time-unavailable",
        "turns": [
          {"user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 15h."}
        ],
        "expect": {
          "never": ["clinic/reschedule"],
          "says": ["Não encontrei vagas"],
          "notSays": ["Posso remarcar"]
        }
      },
      {
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "id": "qualified-yes-is-not-confirmation",
        "turns": [
          {
            "user": "Quero remarcar minha consulta para 13 de outubro de 2026 às 14h.",
            "expect": {"status": "Confirming"}
          },
          {
            "user": "Sim, mas antes preciso saber se aceitam Plano Sorriso?",
            "expect": {
              "status": "Confirming",
              "says": ["Plano Sorriso"]
            }
          },
          {"user": "Não."}
        ],
        "expect": {
          "never": ["clinic/reschedule"],
          "notSays": ["foi remarcada"]
        }
      },
      {
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "id": "two-own-appointments",
        "turns": [
          {
            "user": "Quero remarcar uma das minhas consultas para 13 de outubro de 2026 às 14h.",
            "expect": {
              "status": "WaitingForUser",
              "says": ["limpeza", "avaliação", "02/10", "08/10"]
            }
          },
          {
            "user": "A avaliação com Dra. Ana do dia 8.",
            "expect": {
              "status": "Confirming",
              "says": ["08/10", "10h", "13/10", "14h"]
            }
          },
          {
            "user": "Sim.",
            "expect": {"status": "Succeeded"}
          }
        ],
        "expect": {
          "effects": [
            {"action": "clinic/reschedule", "count": 1, "where": "inputs.appointment.id == 'a3' && inputs.newSlot.id == 's2'"}
          ]
        },
        "state": {
          "clinic": {
            "appointments": [
              {"id": "a1", "patientId": "p1", "dentistId": "d1", "slotId": "old", "start": "2026-10-02T09:00:00-03:00", "label": "limpeza com Dra. Ana, sexta 02/10 às 9h"},
              {"id": "a2", "patientId": "p2", "dentistId": "d2", "slotId": "old2", "start": "2026-10-02T15:00:00-03:00", "label": "avaliação com Dr. Pedro, sexta 02/10 às 15h"},
              {"id": "a3", "patientId": "p1", "dentistId": "d1", "slotId": "old3", "start": "2026-10-08T10:00:00-03:00", "label": "avaliação com Dra. Ana, quinta 08/10 às 10h"}
            ]
          }
        }
      },
      {
        "id": "built-over-messages",
        "simulator": "scripted",
        "caller": {"role": "patient", "patientId": "p1"},
        "turns": [
          {
            "user": "Quero remarcar minha consulta.",
            "expect": {"status": "WaitingForUser"}
          },
          {
            "user": "Dia 13 de outubro de 2026 à tarde.",
            "expect": {
              "status": "WaitingForUser",
              "says": ["14h", "16h"]
            }
          },
          {
            "user": "Às 14h.",
            "expect": {"status": "Confirming"}
          },
          {
            "user": "Sim.",
            "expect": {"status": "Succeeded"}
          }
        ],
        "expect": {
          "effects": [
            {"action": "clinic/slots", "count": 1, "where": "inputs.from == '2026-10-13' && inputs.days == 1"},
            {"action": "clinic/reschedule", "count": 1, "where": "inputs.newSlot.id == 's2'"}
          ],
          "notSays": ["às 8h", "15/10"]
        }
      }
    ]
  }
}
