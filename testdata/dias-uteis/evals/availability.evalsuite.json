          },
          {
            "user": "Sim, confirmo.",
            "expect": {
              "status": "Succeeded",
              "says": [
                "remarcada",
                "17h"
              ]
            }
          }
        ],
        "expect": {
          "status": "Succeeded",
          "effects": [
            {
              "action": "clinic/reschedule",
              "count": 1
            }
          ]
        }
      },
      {
        "id": "greeting",
        "simulator": "scripted",
        "caller": {
          "role": "patient",
