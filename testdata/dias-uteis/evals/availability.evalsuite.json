        }
      },
      {
        "id": "conflicting",
        "simulator": "scripted",
        "caller": {
          "role": "patient",
          "patientId": "p1"
        },
        "turns": [
          {
            "user": "Quero remarcar para 8 de outubro de manhã, às 17h.",
